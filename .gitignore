.env
config.local.js
node_modules/
diagnostic.html
tools/test-output.log
tools/test-results.json
tools/*.log
tools/*.err

# Cache IA durable (généré à l'exécution, jamais versionné)
cache/

# Fichiers d'épreuves téléchargés (jamais versionnés) — seul le manifeste
# d'exemple est suivi, pour servir de modèle au back-office.
epreuves/*
!epreuves/sources-exemple.json

# Les épreuves types sont des documents ORIGINAUX écrits par nous : le
# serveur les sert en téléchargement direct, donc elles sont versionnées.
!epreuves/types/

# Le manifeste des documents officiels indexés : des métadonnées et des
# liens vers la source (aucun document n'est recopié) — versionné.
!epreuves/sujets-officiels.json

tools/test_supabase.js

# Fichier de message de commit (usage local uniquement)
.commit-msg.txt

# Réglages de l'éditeur : configuration personnelle de la machine, hors dépôt.
# Un outil tiers (Cline) les modifiait et les faisait glisser dans les commits
# sans qu'on le demande — le fichier reste sur le disque, mais n'est plus suivi.
.vscode/settings.json
